# Proje klasöründe yeni dosya: .env.example
# İçeriği yapıştır:

# .env.example
# ====================
# 📋 Bu dosya örnek amaçlıdır. 
# Gerçek ayarlar için .env dosyası oluştur ve GitHub Secrets'e ekle!

# === LLM API (OpenRouter) ===
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_MODEL=qwen/qwen-3.6-plus:free
OPENROUTER_FALLBACK_MODEL=google/gemini-flash-1.5:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Image Generation ===
# Hugging Face ZeroGPU (anon da çalışır, token opsiyonel)
HF_ZERO_GPU_TOKEN=hf_xxxxx
HF_MODEL_ID=wan-2-2/text-to-video
IMAGE_GENERATION_TIMEOUT=120

# Fallback: Leonardo.ai (150 free token/day)
LEONARDO_API_KEY=xxxxx

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321
TELEGRAM_MAX_FILE_SIZE=52428800

# === Video Settings ===
VIDEO_RESOLUTION_WIDTH=1080
VIDEO_RESOLUTION_HEIGHT=1920
VIDEO_FPS=24
VIDEO_MAX_DURATION=60
VIDEO_TARGET_SIZE_MB=45

# === Character Reference ===
CHARACTER_NAME=Mavi Fil
CHARACTER_COLOR_PALETTE=#4A90E2,#F5A623,#7ED321
ART_STYLE=flat vector illustration, children book style, consistent character design

# === Logging ===
LOG_LEVEL=INFO
# ====================
# Dosyayı kaydet ✅